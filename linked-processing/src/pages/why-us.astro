---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Why Choose Us">
  <div class="bg-secondary py-12">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-center text-primary mb-12">Why Choose Linked Processing?</h1>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">

        <!-- Security Compliance -->
        <div class="bg-white p-8 rounded-lg shadow-lg flex items-start">
           <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Uncompromising Security</h2>
            <p class="text-gray-600">
              We are fully PCI DSS compliant and utilize the latest security technologies to protect your data and your customers.
            </p>
          </div>
        </div>

        <!-- 24/7 Support -->
        <div class="bg-white p-8 rounded-lg shadow-lg flex items-start">
           <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9 12l2 2 4-4M5.636 5.636l3.536 3.536m0 5.656l-3.536 3.536m12.728 0l-3.536-3.536M5.636 18.364l3.536-3.536"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">24/7 Expert Support</h2>
            <p class="text-gray-600">
              Our dedicated support team is available around the clock to assist you with any questions or issues you may have.
            </p>
          </div>
        </div>

        <!-- Fast Onboarding -->
        <div class="bg-white p-8 rounded-lg shadow-lg flex items-start">
           <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Fast & Easy Onboarding</h2>
            <p class="text-gray-600">
              Our streamlined onboarding process is designed to get your business up and running as quickly as possible.
            </p>
          </div>
        </div>

        <!-- Competitive Rates -->
        <div class="bg-white p-8 rounded-lg shadow-lg flex items-start">
           <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v.01"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Competitive & Transparent Rates</h2>
            <p class="text-gray-600">
              We offer some of the most competitive rates in the industry, with no hidden fees or long-term contracts.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
