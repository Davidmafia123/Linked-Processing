---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Services">
  <div class="bg-white py-12">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-center text-primary mb-12">Our Services</h1>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">

        <!-- Payment Gateway Integration -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg flex items-start">
          <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Payment Gateway</h2>
            <p class="text-gray-600">
              Securely accept credit cards and other payment methods on your website or application with our seamless integration.
            </p>
          </div>
        </div>

        <!-- Fraud Prevention -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg flex items-start">
          <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Fraud Prevention</h2>
            <p class="text-gray-600">
              Protect your business from fraud with our state-of-the-art detection tools that identify and block suspicious activity.
            </p>
          </div>
        </div>

        <!-- Merchant Accounts -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg flex items-start">
          <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Merchant Accounts</h2>
            <p class="text-gray-600">
              We provide reliable and affordable merchant accounts tailored to your specific business needs, from startups to enterprises.
            </p>
          </div>
        </div>

        <!-- Transaction Analytics -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg flex items-start">
          <div class="pr-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"></path></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-primary mb-3">Transaction Analytics</h2>
            <p class="text-gray-600">
              Make data-driven decisions with our powerful analytics dashboard. Track sales, monitor trends, and gain valuable insights.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
