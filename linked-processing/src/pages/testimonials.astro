---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Testimonials">
  <div class="bg-white py-12">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-center text-primary mb-12">What Our Clients Say</h1>
      <div class="space-y-8 max-w-3xl mx-auto">

        <!-- Testimonial 1 -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg">
          <p class="text-gray-600 italic">"Switching to Linked Processing was one of the best decisions we've made. The onboarding was incredibly fast, and their platform is so much more reliable than our previous provider. Their support team is fantastic and always responsive."</p>
          <p class="mt-4 font-bold text-primary">- John Smith, Founder of TechGadgets Inc.</p>
        </div>

        <!-- Testimonial 2 -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg">
          <p class="text-gray-600 italic">"As a small business, we were looking for a payment processor with competitive and transparent pricing. Linked Processing delivered exactly that. There are no hidden fees, and we've saved a significant amount on transaction costs."</p>
          <p class="mt-4 font-bold text-primary">- Sarah Lee, Owner of The Corner Cafe</p>
        </div>

        <!-- Testimonial 3 -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg">
          <p class="text-gray-600 italic">"The security and fraud prevention features from Linked Processing have given us peace of mind. We've seen a noticeable decrease in fraudulent chargebacks since we started using their service. Highly recommended!"</p>
          <p class="mt-4 font-bold text-primary">- Mark Chen, CFO of Global Exports</p>
        </div>

      </div>
    </div>
  </div>
</Layout>
