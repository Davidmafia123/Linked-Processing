---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <div class="bg-white py-12">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-center text-primary mb-12">Let's Talk</h1>
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">

        <!-- Contact Form -->
        <div class="bg-secondary p-8 rounded-lg shadow-lg">
          <h2 class="text-2xl font-bold text-primary mb-6">Send Us a Message</h2>
          <form action="#" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700">Full Name</label>
              <input type="text" id="name" name="name" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent focus:border-accent">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
              <input type="email" id="email" name="email" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent focus:border-accent">
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
              <textarea id="message" name="message" rows="4" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent focus:border-accent"></textarea>
            </div>
            <div>
              <button type="submit" class="w-full bg-accent text-white py-3 px-6 rounded-md hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent">
                Submit
              </button>
            </div>
          </form>
        </div>

        <!-- Business Details -->
        <div class="text-gray-600 pt-8">
          <h2 class="text-2xl font-bold text-primary mb-6">Our Details</h2>
          <p class="mb-4"><strong>Address:</strong><br>123 Finance Street, Suite 100<br>New York, NY 10001</p>
          <p class="mb-4"><strong>Email:</strong><br><a href="mailto:contact@linkedprocessing.com" class="text-accent hover:underline">contact@linkedprocessing.com</a></p>
          <p><strong>Phone:</strong><br>(123) 456-7890</p>
          <div class="mt-8">
              <h3 class="text-xl font-bold text-primary mb-4">Business Hours</h3>
              <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
              <p>Saturday - Sunday: Closed</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
