---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Industries We Serve">
  <div class="bg-secondary py-12">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-center text-primary mb-12">Industries We Serve</h1>
      <div class="max-w-4xl mx-auto">
        <p class="text-center text-lg text-gray-600 mb-10">
          We provide tailored payment solutions for a wide range of industries. Our flexible platform can be adapted to meet the unique challenges and requirements of your specific sector.
        </p>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">Retail</h2>
            <p class="text-gray-600">In-store and online payment solutions to create a seamless shopping experience for your customers.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">E-commerce</h2>
            <p class="text-gray-600">Secure, reliable, and easy-to-integrate payment processing for your online store.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">Hospitality</h2>
            <p class="text-gray-600">Solutions for hotels, restaurants, and resorts to manage payments and bookings efficiently.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">Healthcare</h2>
            <p class="text-gray-600">HIPAA-compliant payment solutions to simplify patient billing and collections.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">Professional Services</h2>
            <p class="text-gray-600">Streamline invoicing and payments for law firms, consulting agencies, and other professional services.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-primary mb-3">And Many More...</h2>
            <p class="text-gray-600">Our platform is versatile. Contact us to find out how we can help your specific industry.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
