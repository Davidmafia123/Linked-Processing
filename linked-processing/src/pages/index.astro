---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="bg-primary text-white text-center py-20">
    <div class="container mx-auto px-6">
      <h1 class="text-5xl font-bold mb-4">Secure Payments. Simplified.</h1>
      <p class="text-xl mb-8">Your trusted partner for seamless and secure payment processing.</p>
      <a href="/contact" class="bg-accent text-white font-bold py-3 px-6 rounded-full hover:opacity-90 transition-opacity">Get Started</a>
    </div>
  </section>

  <!-- Services Preview Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-12 text-primary">Our Services</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="p-8 bg-secondary shadow-lg rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-primary">Payment Gateway</h3>
          <p class="text-gray-600">Securely accept payments online with our robust gateway integration.</p>
        </div>
        <div class="p-8 bg-secondary shadow-lg rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-primary">Fraud Prevention</h3>
          <p class="text-gray-600">Protect your business from fraudulent transactions with our advanced tools.</p>
        </div>
        <div class="p-8 bg-secondary shadow-lg rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-primary">Merchant Accounts</h3>
          <p class="text-gray-600">Get a merchant account that is tailored to the unique needs of your business.</p>
        </div>
        <div class="p-8 bg-secondary shadow-lg rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-primary">Transaction Analytics</h3>
          <p class="text-gray-600">Gain valuable insights from your sales data with our analytics dashboard.</p>
        </div>
      </div>
       <a href="/services" class="mt-12 inline-block bg-accent text-white font-bold py-3 px-6 rounded-full hover:opacity-90 transition-opacity">Explore All Services</a>
    </div>
  </section>

  <!-- Why Choose Us Preview Section -->
  <section class="py-20 bg-secondary">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-12 text-primary">Why Choose Linked Processing?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6">
          <h3 class="text-xl font-bold mb-2 text-primary">Top-Notch Security</h3>
          <p class="text-gray-600">Our platform is PCI DSS compliant, ensuring all your transactions are secure.</p>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold mb-2 text-primary">24/7 Support</h3>
          <p class="text-gray-600">Our expert support team is always available to help you, day or night.</p>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold mb-2 text-primary">Competitive Rates</h3>
          <p class="text-gray-600">We offer affordable and transparent pricing to help your business grow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Preview Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-12 text-primary">What Our Clients Say</h2>
      <div class="max-w-3xl mx-auto">
        <div class="p-8 bg-secondary rounded-lg shadow-lg">
          <p class="text-gray-600 italic">"Linked Processing has been a game-changer for our business. Their platform is reliable, secure, and their support team is second to none. We couldn't be happier!"</p>
          <p class="mt-4 font-bold text-primary">- Jane Doe, CEO of AwesomeCorp</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
